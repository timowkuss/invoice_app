# Invoice App - Environment Configuration
# Copy this to .env and fill in your values

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/invoice_app

# Mistral OCR API Key
MISTRAL_API_KEY=your_mistral_api_key_here
# Set this from your current Mistral tariff to estimate expenses in the admin dashboard
MISTRAL_COST_PER_1000_PAGES_USD=4

# Telegram Bot Token (get from @BotFather)
TELEGRAM_TOKEN=your_telegram_bot_token_here

# JWT Secret Key (change this!)
SECRET_KEY=change-this-to-a-random-secret-key

# Web UI URL (used in Telegram links)
WEB_URL=http://localhost:8000

# Owner account (created automatically on first start)
ADMIN_EMAIL=owner@example.com
ADMIN_PASSWORD=replace-with-a-strong-password

# Password reset email (SMTP)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=owner@example.com
SMTP_PASSWORD=replace-with-smtp-password
SMTP_FROM=owner@example.com
SMTP_STARTTLS=true
# SMTP_SSL=false

# Shared absolute data directory for web and Telegram processes (optional)
# DATA_DIR=C:/invoice-app/data
# Web process consumes the persistent OCR queue
OCR_WORKER=true
